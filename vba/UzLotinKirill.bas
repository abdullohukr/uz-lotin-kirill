        ChrW(&H2BC) & ChrW(&H2B9) & ChrW(&H2BD) & ChrW(&H2032) & ChrW(&HFF07&)
    ' a b v g d e yo j z i y k l m n o p r s t u f x ts ch sh shch hard y soft e yu ya u' q g' h
    CYRSET = ""
    For i = &H430 To &H435: CYRSET = CYRSET & ChrW(i): Next i
    CYRSET = CYRSET & ChrW(&H451)
    For i = &H436 To &H44F: CYRSET = CYRSET & ChrW(i): Next i
    CYRSET = CYRSET & ChrW(&H45E) & ChrW(&H49B) & ChrW(&H493) & ChrW(&H4B3)
    cA = ChrW(&H430): cS = ChrW(&H441): cHh = ChrW(&H4B3): cSh = ChrW(&H448): cCh = ChrW(&H447)
    cU = ChrW(&H45E): cGh = ChrW(&H493): cYo = ChrW(&H451): cYu = ChrW(&H44E): cYa = ChrW(&H44F)
    cYe = ChrW(&H435): cE = ChrW(&H44D): cTs = ChrW(&H446): cHard = ChrW(&H44A): cSoft = ChrW(&H44C)
    cM = ChrW(&H43C)
    ' vowels: a e yo i o u e yu ya u'
    CYRV = ChrW(&H430) & ChrW(&H435) & ChrW(&H451) & ChrW(&H438) & ChrW(&H43E) & ChrW(&H443) & _
        ChrW(&H44D) & ChrW(&H44E) & ChrW(&H44F) & ChrW(&H45E)
    ' Latin single letters -> Cyrillic
    LATSRC = "abdfghijklmnopqrstuvxyze"
    LATDST = UDec("{0430}{0431}{0434}{0444}{0433}{04B3}{0438}{0436}{043A}{043B}{043C}{043D}" & _
        "{043E}{043F}{049B}{0440}{0441}{0442}{0443}{0432}{0445}{0439}{0437}{0435}")
    ' Cyrillic single letters -> Latin
    CYRSRC = UDec("{0430}{0431}{0432}{0433}{0434}{0436}{0437}{0438}{0439}{043A}{043B}{043C}{043D}" & _
        "{043E}{043F}{0440}{0441}{0442}{0443}{0444}{0445}{04B3}{049B}{0447}{0448}{0449}{044B}" & _
        "{044D}{0451}{044E}{044F}{044C}")
    CYRDST = Array("a", "b", "v", "g", "d", "j", "z", "i", "y", "k", "l", "m", "n", _
        "o", "p", "r", "s", "t", "u", "f", "x", "h", "q", "ch", "sh", "sh", "i", _
        "e", "yo", "yu", "ya", "")
End Sub

Private Function LugatPath() As String
    LugatPath = NormalTemplate.Path & Application.PathSeparator & LUGAT_FILE
End Function

' My dictionary: "lotin = kirill" per line, a single word = never convert.
Private Sub LoadLugat()
    Dim p As String, d As Document, t As String, stamp As String, found As Boolean
    Dim lines() As String, i As Long, ln As String, e As Long, lat As String, cyr As String
    p = LugatPath()
    On Error Resume Next
    For Each d In Documents
        If d.FullName = p Then t = d.Content.Text: found = True: Exit For
    Next d
    If Not found Then
        If Len(Dir(p)) = 0 Then
            Set gUL2C = New Collection: Set gUC2L = New Collection: Set gSkip = New Collection
            gLugatStamp = ""
            Exit Sub
        End If
        stamp = CStr(FileDateTime(p))
        If stamp = gLugatStamp Then Exit Sub
        Set d = Documents.Open(FileName:=p, ReadOnly:=True, AddToRecentFiles:=False, Visible:=False)
        t = d.Content.Text
        d.Close SaveChanges:=wdDoNotSaveChanges
        gLugatStamp = stamp
    Else
        gLugatStamp = ""
    End If
    On Error GoTo 0
    Set gUL2C = New Collection: Set gUC2L = New Collection: Set gSkip = New Collection
    lines = Split(Replace(t, vbLf, vbCr), vbCr)
    For i = LBound(lines) To UBound(lines)
        ln = Trim$(Replace(lines(i), ChrW(&HA0), " "))
        If Len(ln) > 0 And Left$(ln, 1) <> "#" Then
            e = InStr(1, ln, "=")
            If e > 0 Then
                lat = Trim$(Left$(ln, e - 1)): cyr = Trim$(Mid$(ln, e + 1))
                If Len(lat) > 0 And Len(cyr) > 0 Then
                    CAdd gUL2C, LatKey(NormLatin(lat)), LC(cyr)
                    CAdd gUC2L, Enc(LC(cyr)), LC(lat)
                End If
            Else
                CAdd gSkip, "L" & LatKey(NormLatin(ln)), "1"
                CAdd gSkip, "C" & Enc(LC(ln)), "1"
            End If
        End If
    Next i
End Sub

Private Sub AddLE(ByVal k As String, ByVal v As String)
    CAdd gL2C, k, Dec(v)
End Sub

Private Sub AddLS(ByVal k As String, ByVal v As String)
    CAdd gL2CStem, k, Dec(v)
    If Len(k) > gMaxL2C Then gMaxL2C = Len(k)
End Sub

Private Sub AddCE(ByVal k As String, ByVal v As String)
    CAdd gC2L, k, v
End Sub

Private Sub AddCS(ByVal k As String, ByVal v As String)
    CAdd gC2LStem, k, v
    If Len(Dec(k)) > gMaxC2L Then gMaxC2L = Len(Dec(k))
End Sub

' ============================== self test

Private Sub T(ByVal toLat As Boolean, ByVal inp As String, ByVal want As String)
    Dim got As String
    inp = UDec(inp): want = UDec(want)
    got = ConvertText(inp, toLat)
    gTestN = gTestN + 1
    If StrComp(got, want, vbBinaryCompare) <> 0 Then
        gTestFail = gTestFail + 1
        If Len(gTestMsg) < 900 Then gTestMsg = gTestMsg & inp & " -> " & got & " (" & want & ")" & vbCr
    End If
End Sub

